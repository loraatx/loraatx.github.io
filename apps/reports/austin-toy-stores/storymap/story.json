{
  "title": "Toy Stores & Children's Specialty Retailers in Greater Austin",
  "subtitle": "A City Anatomy Story",
  "loop": true,
  "autoplay": true,
  "initialCamera": {
    "center": [-97.745, 30.310],
    "zoom": 10,
    "pitch": 0,
    "bearing": 0
  },

  "layers": [
    {
      "id": "toy-stores",
      "type": "circle",
      "source": "data/austin-toy-stores.geojson",
      "paint": {
        "circle-color": "#d4380d",
        "circle-opacity": 0
      },
      "transitionOpacity": 0.7,
      "transitionDuration": 700
    }
  ],

  "scenes": [
    {
      "id": "overview",
      "transition": "fly",
      "duration": 11000,
      "camera": {
        "center": [-97.745, 30.310],
        "zoom": 10.5,
        "pitch": 30,
        "bearing": -10,
        "speed": 0.55,
        "curve": 1.2
      },
      "showLayers": ["toy-stores"],
      "hideLayers": [],
      "popup": {
        "lngLat": [-97.745, 30.310],
        "anchor": "bottom",
        "video": {
          "src": "promo.mp4"
        }
      }
    },

    {
      "id": "terra-toys",
      "transition": "fly",
      "duration": 6500,
      "camera": {
        "center": [-97.733110, 30.357190],
        "zoom": 16,
        "pitch": 55,
        "bearing": 20,
        "speed": 0.75,
        "curve": 1.4
      },
      "showLayers": ["toy-stores"],
      "hideLayers": [],
      "popup": {
        "lngLat": [-97.733110, 30.357190],
        "title": "Terra Toys",
        "subtitle": "2438 W Anderson Ln · North Central Austin",
        "body": "<p>Austin's original toy store since 1978. Terra carries classic toys, art supplies, musical instruments, kites, and learning tools — with a demo-friendly browsing experience and an in-store cafe.</p>",
        "stats": [
          { "label": "Founded",   "value": "1978" },
          { "label": "Type",      "value": "Independent" },
          { "label": "Ages",      "value": "All Ages" }
        ],
        "link": {
          "href": "/apps/reports/austin-toy-stores/storymap/report.html",
          "text": "Read the Full Report →"
        }
      }
    },

    {
      "id": "closing-cta",
      "transition": "fly",
      "duration": 7000,
      "camera": {
        "center": [-97.745, 30.310],
        "zoom": 10.5,
        "pitch": 30,
        "bearing": 0,
        "speed": 0.5,
        "curve": 1.2
      },
      "showLayers": ["toy-stores"],
      "hideLayers": [],
      "popup": {
        "lngLat": [-97.745, 30.310],
        "title": "City Anatomy",
        "subtitle": "Local data products for Austin",
        "image": {
          "src": "../../template/siteimage.png",
          "alt": "City Anatomy",
          "caption": "Explore Austin through data"
        },
        "links": [
          {
            "href": "/apps/reports/austin-toy-stores/storymap/report.html",
            "text": "Read the Report"
          },
          {
            "href": "/apps/reports/austin-toy-stores/",
            "text": "Interactive Map"
          }
        ]
      }
    }
  ]
}
