{
  "title": "Austin's Neighborhoods",
  "subtitle": "Historic, eclectic, and master-planned communities",
  "loop": true,
  "autoplay": true,
  "initialCamera": {
    "center": [-97.754, 30.264],
    "zoom": 10,
    "pitch": 0,
    "bearing": 0
  },

  "layers": [
    {
      "id": "neighborhoods",
      "type": "circle",
      "source": "data/austin-neighborhoods.geojson",
      "paint": {
        "circle-radius": 9,
        "circle-color": "#2B6CB0",
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 2,
        "circle-opacity": 0
      },
      "transitionOpacity": 0.95,
      "transitionDuration": 700
    }
  ],

  "scenes": [
    {
      "id": "overview",
      "transition": "fly",
      "duration": 7000,
      "camera": {
        "center": [-97.754, 30.264],
        "zoom": 10.5,
        "pitch": 30,
        "bearing": -10,
        "speed": 0.55,
        "curve": 1.2
      },
      "showLayers": ["neighborhoods"],
      "hideLayers": [],
      "popup": {
        "lngLat": [-97.754, 30.264],
        "anchor": "bottom",
        "title": "Historic & Emerging Neighborhoods of Austin",
        "subtitle": "A Product Intelligence Report",
        "body": "33 Austin neighborhoods are surveyed in this report. Eras covered range from 19th-century freedmen's settlements and early streetcar suburbs to postwar bungalow districts and 21st-century master-planned communities. Clarksville — one of the oldest freedmen's towns west of the Mississippi — and Mueller, built on the former municipal airport site, are two highlighted locations from the report.",
        "link": {
          "href": "/apps/productreports/austin-neighborhoods/",
          "text": "Open the interactive map →"
        }
      }
    },

    {
      "id": "clarksville",
      "transition": "fly",
      "duration": 7500,
      "camera": {
        "center": [-97.762, 30.275],
        "zoom": 14.5,
        "pitch": 55,
        "bearing": 35,
        "speed": 0.8,
        "curve": 1.4
      },
      "showLayers": ["neighborhoods"],
      "hideLayers": [],
      "popup": {
        "lngLat": [-97.762, 30.275],
        "anchor": "bottom",
        "title": "Clarksville",
        "subtitle": "West Austin · Founded 1871",
        "body": "Founded in 1871 by Charles Clark, Clarksville is one of the first freedmen's towns established west of the Mississippi River. Highway construction substantially reduced its original footprint, but it remains a critical chapter in Austin's African American history. Among the oldest intact freedmen's communities in Texas.",
        "stats": [
          { "label": "Founded",  "value": "1871"         },
          { "label": "Type",     "value": "Freedmen's town" },
          { "label": "Area",     "value": "West Austin"  }
        ],
        "link": {
          "href": "/apps/productreports/austin-neighborhoods/",
          "text": "View on the map →"
        }
      }
    },

    {
      "id": "mueller",
      "transition": "fly",
      "duration": 7500,
      "camera": {
        "center": [-97.704, 30.300],
        "zoom": 13,
        "pitch": 50,
        "bearing": -45,
        "speed": 0.8,
        "curve": 1.4
      },
      "showLayers": ["neighborhoods"],
      "hideLayers": [],
      "popup": {
        "lngLat": [-97.704, 30.300],
        "anchor": "bottom",
        "title": "Mueller",
        "subtitle": "East Austin · Former municipal airport site",
        "body": "Built on the former Robert Mueller Municipal Airport, Mueller is one of the country's most prominent new-urbanist infill redevelopments — targeting thousands of mixed-income homes with a fine-grained street grid and extensive parks. A national model for converting decommissioned urban airport land into walkable neighborhoods.",
        "stats": [
          { "label": "Site size",   "value": "700+ acres"    },
          { "label": "Type",        "value": "New-urbanist infill" },
          { "label": "Area",        "value": "East Austin"   }
        ],
        "link": {
          "href": "/apps/productreports/austin-neighborhoods/",
          "text": "View on the map →"
        }
      }
    },

    {
      "id": "closing",
      "transition": "fly",
      "duration": 8000,
      "camera": {
        "center": [-97.754, 30.264],
        "zoom": 10.5,
        "pitch": 30,
        "bearing": -10,
        "speed": 0.55,
        "curve": 1.2
      },
      "showLayers": ["neighborhoods"],
      "hideLayers": [],
      "popup": {
        "lngLat": [-97.754, 30.264],
        "anchor": "bottom",
        "title": "Get the Full Report",
        "subtitle": "All 33 neighborhoods — history, demographics, and character",
        "image": {
          "src": "../../template/siteimage.png",
          "alt": "Neighborhoods Product Intelligence Report preview",
          "caption": "Interactive map + written report"
        },
        "link": {
          "href": "report.html",
          "text": "Read the full report →"
        }
      }
    }
  ]
}
